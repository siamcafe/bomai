# ============================================================
# BOM AI - god_config.env  (Open WebUI OEM deployment configuration)
# Part of: bomai installer_assembly (project bomai, step installer-config-assembly)
# Source: Phase A Topic 4 research (2026-10-05) - see research_topics4-5.yaml
# Target: Open WebUI current main (docs.openwebui.com/reference/env-configuration)
#
# HOW TO USE
#   pip route:   set -a; . ./god_config.env; set +a; open-webui serve --host 127.0.0.1 --port 8787
#   (Windows PowerShell: load each line into $env: before serve, or use --env-file via docker)
#   docker:      docker run -d -p 127.0.0.1:8787:8080 --env-file god_config.env \
#                  --add-host=host.docker.internal:host-gateway \
#                  -v bomai-webui:/app/backend/data ghcr.io/open-webui/open-webui:main
#
# LAWS (verified against source, see research_topics4-5.yaml for evidence):
#   L1 ConfigVar persistence: most settings below are "PersistentConfig" - the env value
#      SEEDS the config DB on FIRST boot (fresh DATA_DIR); afterwards the admin panel owns
#      them and later env changes are ignored (issue #29074, discussion #4573).
#      => god_config.env must be in place BEFORE first launch (installer does this).
#      => To force env-always-wins, uncomment ENABLE_PERSISTENT_CONFIG=False below
#         (cost: admin-panel changes stop persisting across restarts).
#   L2 WEBUI_NAME auto-append (backend/open_webui/env.py L951-953): any value other than
#      'Open WebUI' gets ' (Open WebUI)' appended IN CODE. Set the bare brand only.
#   L3 Never bind 0.0.0.0 while WEBUI_AUTH=False - the local admin API would be exposed
#      to the LAN with no password. Launcher must use --host 127.0.0.1 (or -p 127.0.0.1:).
#   L4 CUSTOM_NAME must stay UNSET: it polls api.openwebui.com at runtime
#      (breaks offline promise + phones home).
# ============================================================

# ---------- [1] BRANDING ----------
# License law: Open WebUI LICENSE clause 4 forbids removing/altering "Open WebUI"
# branding (exceptions: <=50 end users per deployment in 30 days, written permission,
# enterprise license). BOM AI ships one local instance per end user, but keeps the
# attribution anyway - and env.py L951-953 enforces it regardless:
#   WEBUI_NAME = os.getenv('WEBUI_NAME', 'Open WebUI')
#   if WEBUI_NAME != 'Open WebUI': WEBUI_NAME += ' (Open WebUI)'
# => UI renders "BOM AI (Open WebUI)". Do NOT write the suffix yourself (double suffix).
WEBUI_NAME="BOM AI"

# WEBUI_FAVICON_URL: NOT env-configurable - hardcoded to
# https://openwebui.com/favicon.png in env.py L959. Swapping the favicon requires a
# reverse-proxy URL rewrite or a fork; default is kept (also license-friendly).
# WEBUI_BANNERS: JSON array of {id,type,content}; ConfigVar. Empty = no banner.
WEBUI_BANNERS=[]

# WEBUI_URL: public URL, used for OAuth/SSO redirects (ConfigVar). Not needed for
# 127.0.0.1 kiosk mode; informational only.
# WEBUI_URL=http://127.0.0.1:8787

# ---------- [2] SECURITY / AUTH ----------
# Installer MUST generate a per-machine random secret on first install
# (PowerShell: -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
#  bash: openssl rand -hex 32). Sessions stay valid across restarts only if stable.
WEBUI_SECRET_KEY=REPLACE_WITH_RANDOM_HEX64_AT_INSTALL

# Kiosk mode (SHIPPED DEFAULT): no login screen at all; Open WebUI auto-logs-in a
# built-in local admin (admin@localhost) on first visit - true single-user local mode.
# Signup is inherently closed (auth off). MUST pair with 127.0.0.1 binding (law L3).
WEBUI_AUTH=False

# --- Option B (commented): headless admin bootstrap WITH passwords ---
# First boot creates the admin from these vars and auto-disables signup
# (main.py L376-380: create_admin_user(...) then Config.upsert({'ui.enable_signup': False})).
# ENABLE_LOGIN_FORM must then stay True (with auth on and form off there is no way in
# without OAuth/trusted-header).
# WEBUI_AUTH=True
# WEBUI_ADMIN_EMAIL=bom@localhost
# WEBUI_ADMIN_PASSWORD=REPLACE_AT_INSTALL
# WEBUI_ADMIN_NAME=BOM
# ENABLE_INITIAL_ADMIN_SIGNUP=False

# ConfigVars below take effect on first boot (law L1); kept explicit for documentation.
ENABLE_SIGNUP=False
ENABLE_LOGIN_FORM=False

# ---------- [3] OLLAMA CONNECTION ----------
# Default is http://localhost:11434; explicit 127.0.0.1 for BOM AI (docker route must
# use http://host.docker.internal:11434 instead - the launcher picks per deployment).
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ---------- [4] MODEL DEFAULTS ----------
# Comma-separated list of model ids (NOT semicolons - InterfaceSettings.svelte L392
# does default_models.split(',')[0]). First entry = the model new chats open with.
DEFAULT_MODELS=bomai:v8b
# Matches Modelfile_v8b sampling params; keys map to Open WebUI advanced params
# (temperature/top_p/top_k/num_ctx/num_predict are forwarded as Ollama options).
DEFAULT_MODEL_PARAMS={"temperature":0.6,"top_p":0.95,"top_k":20,"num_ctx":8192,"num_predict":2048}
# Optional per-model overrides; empty = none.
DEFAULT_MODEL_METADATA={}
# Task backend (title generation / tags / autocomplete) rides the same local model.
TASK_MODEL=bomai:v8b
TASK_MODEL_PARAMS={"temperature":0.3,"top_p":0.9,"num_predict":256}

# ---------- [5] PRIVACY / TELEMETRY-LIKE TOGGLES ----------
# No sharing links, no thumbs-up/down data collection (both default True upstream).
ENABLE_COMMUNITY_SHARING=False
ENABLE_MESSAGE_RATING=False

# ---------- [6] RAG / SEARCH (offline document chat) ----------
# Engine '' = local sentence-transformers (default; no OpenAI call).
RAG_EMBEDDING_ENGINE=
# Default upstream is sentence-transformers/all-MiniLM-L6-v2 which is weak on Thai.
# BAAI/bge-m3 is multilingual (Thai included); ~2.2GB - the installer must pre-bundle
# it into the offline wheelhouse or it will download on first use.
# Lighter alternative: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 (~470MB).
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_BATCH_SIZE=1

# ---------- [7] LOCALIZATION ----------
# ConfigVar; empty = follow browser language. th-TH makes Thai the default UI locale.
DEFAULT_LOCALE=th-TH

# ---------- [8] STORAGE / PERSISTENCE ----------
# Where Open WebUI keeps its DB/uploads. Launcher sets per-OS:
#   Windows: %LOCALAPPDATA%\BomAI\webui-data   macOS: ~/Library/Application Support/BomAI
#   Linux:   ~/.local/share/BomAI
# DATA_DIR=/set/by/launcher
# See law L1: keep True for a normal consumer build (env seeds once, user can then
# tweak in admin panel). Uncomment to hard-freeze the god config.
# ENABLE_PERSISTENT_CONFIG=False

# ---------- [9] DESKTOP DEPLOYMENT PATTERN (reference) ----------
# Launcher sequence (per k3 blueprint, all three steps local):
#   1. start Ollama       : ollama app / `ollama serve` (BOM-managed, 127.0.0.1:11434)
#   2. start Open WebUI   : open-webui serve --host 127.0.0.1 --port 8787  (pip install
#                           open-webui, Python 3.11; or docker -p 127.0.0.1:8787:8080)
#   3. open app window    : Edge/Chrome  --app=http://127.0.0.1:8787  (desktop-app look)
# Windows service wrappers (only if auto-start on boot is wanted):
#   NSSM  (nssm.cc)            : nssm install BomAI-WebUI "open-webui.cmd" (classic,
#                                no release in years) 
#   WinSW (github.com/winsw/winsw): XML-config wrapper, actively maintained - preferred.
# Launcher (tray icon + port wait + browser --app) is the BOM AI default; a service is
# opt-in during install.
